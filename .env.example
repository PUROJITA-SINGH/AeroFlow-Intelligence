# Backend - Render/local
# Render injects PORT automatically for each web service. Keep this unset locally unless needed.
PORT=8000

# Full PostgreSQL connection string used by FastAPI, Alembic, and ML scripts.
DATABASE_URL=postgresql://aeroflow:<password>@<host>:5432/aeroflow

# Strong JWT signing secret. Use at least 32 random characters; 64 hex chars is recommended.
SECRET_KEY=replace_with_64_random_hex_characters_000000000000000000000000

# Runtime environment name. Set to production to disable interactive API docs.
ENV=production

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=https://aeroflow-ui.onrender.com

# JWT access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JWT issuer claim expected by the API.
JWT_ISSUER=aeroflow-api

# JWT audience claim expected by the API.
JWT_AUDIENCE=aeroflow-client

# Frontend
# API base URL compiled into the Vite React app. Render exposes this at build time.
VITE_API_URL=https://aeroflow-api.onrender.com

# Docker
# PostgreSQL username for local Docker Compose.
POSTGRES_USER=aeroflow

# PostgreSQL password for local Docker Compose.
POSTGRES_PASSWORD=replace_with_local_dev_password

# PostgreSQL database name for local Docker Compose.
POSTGRES_DB=aeroflow

# Sensor
# API base URL used by Streamlit pages and camera_sensor.py.
AEROFLOW_API_URL=https://aeroflow-api.onrender.com

# Username for the authenticated camera/sensor ingestion user.
AEROFLOW_SENSOR_USERNAME=sensor_operator

# Password for the authenticated camera/sensor ingestion user.
AEROFLOW_SENSOR_PASSWORD=replace_with_sensor_user_password

# Optional
# Set true only for a dedicated worker process that should run the simulator and alert engine.
RUN_BACKGROUND_WORKERS=false

# Set true only when the API process should refresh predictions during startup.
RUN_PREDICTIONS_ON_STARTUP=false

# Optional absolute path to ML model artifacts. Defaults to the repository ML_Models folder.
AEROFLOW_ML_DIR=/app/ML_Models

# Optional model directory used by backend background jobs.
ML_DIR=/app/ML_Models

# Optional PostgreSQL pool tuning for hosted PostgreSQL connection limits.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300
